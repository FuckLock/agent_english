-  const hasChinese = chinesePattern.test(answer);
-  const enoughEnglish = englishWords.length >= 4;
-  const soundsNatural = politePattern.test(answer) || input.turnOrder > 1;
-  const passed = !hasChinese && enoughEnglish && soundsNatural;
