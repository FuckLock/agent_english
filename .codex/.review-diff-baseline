-      return 0;
-    case "graze":
-      return 14;
-    case "hit":
-      return 28;
-    case "critical":
-      return 42;
-    case "stagger":
-      return 60;
-  }
-}
-
-function computeComboNext(input: {
-  passed: boolean;
-  comboBefore: number;
-  rescueUsedThisRound: boolean;
