# model-gateway service environment（Pro / Max 大模型翻译·点词解释·学习卡 + 听音 ASR + 账号/权益）
# 所有 key 只在服务端，绝不进 iOS / browser-agent / App bundle。
# 本文件提交进库（.gitignore 已豁免 .env.example）；真实值复制为 .env 后填入（.env 不进库）。
#
# 翻译分层（ADR-0005 v2.7）：
#   - Free 文本/字幕翻译  → services/translation-proxy（便宜大模型，配 translation-proxy/.env）
#   - Pro / Max 翻译·解释 → 本服务 model-gateway（更强模型，配本文件）
#   - 两个服务独立部署，互不依赖。

# 监听端口（独立于 translation-proxy 的 4200）
MODEL_GATEWAY_PORT=4100

# ============ 大模型 Provider（统一走 OpenAI 兼容 Chat Completions）============
# 规则：每个 provider 三项齐备（API Key + Model + Base URL）才装配；缺任一则该 provider 跳过。
# tier → 用哪个 provider + fallback 顺序，定义在 src/providers/provider-router.ts 的 providersForModel()：
#     Max 档（max-mentor）  → anthropic → openai
#     Pro 档（pro-context） → openai → deepseek
#     （free-translate 档）  → deepseek → openai
#       注：Free 文本翻译实际走 translation-proxy（ADR-0005 v2.7 已解耦）；
#           model-gateway 的 free-translate 档当前主要用于模型目录展示与未来回退，
#           不是 Free 用户翻译的实际后端。
# 用户可见的档位显示名 / 能力，在 src/catalog/model-catalog.ts 的 BASE_OPTIONS。
# Base URL 必须指向 OpenAI 兼容的 /chat/completions 端点。

# OpenAI（或任意 OpenAI 兼容厂商）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_TIMEOUT_MS=15000

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_TIMEOUT_MS=15000

# Anthropic（注意：key 变量名是 ANTHROPIC_SECRET_KEY；Base URL 需为 OpenAI 兼容端点）
ANTHROPIC_SECRET_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/chat/completions
ANTHROPIC_TIMEOUT_MS=15000

# ============ dev / staging 测试账号（生产必须关闭）============
# 仅 dev/staging 用来登录 Pro / Max 测试账号验证高等级模型；生产环境必须 ENABLE_DEV_AUTH=false。
ENABLE_DEV_AUTH=false
DEV_AUTH_TEST_PRO_PASSWORD=
DEV_AUTH_TEST_MAX_PASSWORD=

# ============ 听音 ASR ============
# 当前 src/providers/asr-provider.ts 为 UnavailableASRProvider 占位（听音 Beta 尚未接真实 ASR）。
# 接入真实 ASR provider 后，在此补对应的 ASR key / endpoint 环境变量。
