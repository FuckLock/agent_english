# model-gateway service environment（Pro / Max 大模型翻译·点词解释·学习卡 + 听音 ASR + 账号/权益）
# 所有 key 只在服务端，绝不进 iOS / browser-agent / App bundle。
# 本文件提交进库（.gitignore 已豁免 .env.example）；真实值复制为 .env 后填入（.env 不进库）。
#
# 翻译分层（ADR-0005 v2.7）：
#   - Free 文本/字幕翻译  → services/translation-proxy（便宜大模型，配 translation-proxy/.env）
#   - Pro / Max 翻译·解释 → 本服务 model-gateway（更强模型，配本文件）
#   - 两个服务独立部署，互不依赖。

# 监听端口（独立于 translation-proxy 的 4200）
MODEL_GATEWAY_PORT=4100

# ============ 大模型 Provider 凭证（统一走 OpenAI 兼容 Chat Completions）============
# 规则（ADR-0006）：env 只配「凭证」——API Key + Base URL 齐备才装配该 vendor，缺任一则跳过。
# **不再配模型名槽**：真实模型名（realModelName）随后端模型清单 registry 走
#   （src/catalog/model-registry.ts，唯一真相源、绝不下发），一个 vendor 凭证可被多条模型条目复用。
# 路由链（主 vendor + fallbackVendors）由模型条目自带，provider-router 读条目字段路由——
#   不再由 env *_MODEL 或写死的 tier→provider switch 决定。
# 用户可见的档位目录由 registry 驱动投影生成（src/catalog/model-catalog.ts，脱敏、不含内部路由字段）。
# Base URL 必须指向 OpenAI 兼容的 /chat/completions 端点。

# OpenAI（或任意 OpenAI 兼容厂商）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_TIMEOUT_MS=15000

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_TIMEOUT_MS=15000

# Anthropic（注意：key 变量名是 ANTHROPIC_SECRET_KEY；Base URL 需为 OpenAI 兼容端点）
ANTHROPIC_SECRET_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/chat/completions
ANTHROPIC_TIMEOUT_MS=15000

# ============ dev / staging 测试账号（生产必须关闭）============
# 仅 dev/staging 用来登录 Pro / Max 测试账号验证高等级模型；生产环境必须 ENABLE_DEV_AUTH=false。
ENABLE_DEV_AUTH=false
DEV_AUTH_TEST_PRO_PASSWORD=
DEV_AUTH_TEST_MAX_PASSWORD=

# ============ 听音 ASR（Phase 8.12：自部署 Whisper + ffmpeg）============
# 后端运行依赖（dependency，不进 iOS / browser-agent / App bundle）：
#   - ffmpeg：把按 Range 拉取的音频流片段转 16kHz 单声道 wav（src/providers/audio-segment-fetcher.ts，
#             默认走 PATH 上的 ffmpeg，纯内存 pipe 转码、不落盘）。部署机必须安装 ffmpeg。
#   - 自部署 Whisper（whisper.cpp whisper-cli，默认档位 ggml-base.en）：把 wav 识别成英文 transcript + 时间轴
#             （src/providers/asr-provider.ts 的 WhisperASRProvider，只产英文、不翻译）。部署机必须安装 whisper-cli + 模型文件。
# 识别与翻译解耦：Whisper 只「英文语音→英文文字」，翻译仍由 routeTranslation 走分层（Free→translation-proxy / Pro·Max→model-gateway）。
# 合规（ADR-0004 v2.11）：实时按进度拉片段、用完即弃，不持久化整轨 / 不缓存 / 不再分发。
#
# WHISPER_BIN：whisper.cpp 可执行文件（默认 whisper-cli，需在 PATH 或给绝对路径，如 /opt/homebrew/bin/whisper-cli）
WHISPER_BIN=whisper-cli
# WHISPER_MODEL：Whisper 模型文件绝对路径（必填，无则 ASR 不可用归一），如 /opt/models/ggml-base.en.bin
WHISPER_MODEL=
# WHISPER_LANGUAGE：识别语言（默认 en）
WHISPER_LANGUAGE=en
# ASR_TRANSCODE_TIMEOUT_MS：单次 Whisper 识别超时（毫秒，默认 60000）
ASR_TRANSCODE_TIMEOUT_MS=60000
# ASR_STREAM_MAX_RETRIES（可选）：InnerTube 取流遇云 IP 反爬（429/403/5xx）的重试次数（默认 2，见 youtube-audio-stream.ts）
