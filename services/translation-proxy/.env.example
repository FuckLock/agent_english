# translation-proxy service environment (Free 文本翻译第三方通用翻译转发)
# 这些 key 只托管在 translation-proxy 服务端，绝不进入 iOS / browser-agent / App bundle。
# 仅放占位键名，真实值通过部署环境注入；本文件提交进库（.gitignore 已豁免 .env.example）。

# 监听端口（独立于大模型 gateway 的端口）
TRANSLATION_PROXY_PORT=4200

# Google Cloud Translation 通用翻译
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_ENDPOINT=https://translation.googleapis.com/language/translate/v2

# Microsoft / Azure Translator 通用翻译
AZURE_TRANSLATOR_API_KEY=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/translate
AZURE_TRANSLATOR_REGION=

# 每个 session 每日 Free 文本翻译 segment 限额（参数化，不硬编码进源码）
TRANSLATION_PROXY_SESSION_SEGMENT_LIMIT=2000

# 单次转发给第三方 Provider 的最大字符块大小（分块阈值）
TRANSLATION_PROXY_CHUNK_CHAR_LIMIT=1200
