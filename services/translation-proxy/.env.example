# translation-proxy service environment (Free 文本翻译后端：便宜大模型 OpenAI 兼容 Chat Completions)
# 这些 key 只托管在 translation-proxy 服务端，绝不进入 iOS / browser-agent / App bundle。
# 仅放占位键名，真实值通过部署环境注入；本文件提交进库（.gitignore 已豁免 .env.example）。

# 监听端口（独立于大模型 gateway 的端口）
TRANSLATION_PROXY_PORT=4200

# 默认 Free 翻译后端：OpenAI 兼容大模型 Chat Completions（如 DeepSeek V3 等便宜大模型）。
# 三项齐备（Base URL + API Key + 模型名）时为首选 provider。Base URL 指向 /chat/completions。
TRANSLATION_LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
TRANSLATION_LLM_API_KEY=
TRANSLATION_LLM_MODEL=deepseek-chat

# 每个 session 每日 Free 文本翻译 segment 限额（参数化，不硬编码进源码）
TRANSLATION_PROXY_SESSION_SEGMENT_LIMIT=2000

# 单次转发给 Provider 的最大字符块大小（分块阈值）
TRANSLATION_PROXY_CHUNK_CHAR_LIMIT=1200

# ---- 可选 / 默认不启用：仅在需要回退到第三方通用翻译时配置 ----
# Google Cloud Translation（可选；未配置则不进 provider 列表）
# GOOGLE_TRANSLATE_API_KEY=
# GOOGLE_TRANSLATE_ENDPOINT=https://translation.googleapis.com/language/translate/v2

# Microsoft / Azure Translator（可选；未配置则不进 provider 列表）
# AZURE_TRANSLATOR_API_KEY=
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/translate
# AZURE_TRANSLATOR_REGION=
