{
  "name": "@agent-english/translation-proxy",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @agent-english/contracts build && tsc -p tsconfig.json",
    "check": "pnpm --filter @agent-english/contracts build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "start": "node --env-file=.env dist/index.js",
    "dev": "pnpm build && node --env-file=.env dist/index.js"
  },
  "dependencies": {
    "@agent-english/contracts": "workspace:*"
  }
}
