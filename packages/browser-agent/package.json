{
  "name": "@agent-english/browser-agent",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bridge/bootstrap": {
      "types": "./dist/bridge/bootstrap.d.ts",
      "default": "./dist/bridge/bootstrap.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @agent-english/contracts build && tsc -p tsconfig.json",
    "check": "pnpm --filter @agent-english/contracts build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@agent-english/contracts": "workspace:*"
  }
}
